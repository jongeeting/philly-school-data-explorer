# Layers rebuilt by script or too large for git (see docs/DATA_MODEL.md, "Storage, layers and tooling")
raw/*
staging/*
!raw/.gitkeep
!staging/.gitkeep
prototype/raw/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Env / OS
.env*
.DS_Store

# Internal strategy docs (host options, faction assessments); never commit
private/

# Built tables are published as release assets, not committed (registry/ IS committed)
core/*
!core/.gitkeep
marts/*
!marts/.gitkeep
derived/*
!derived/.gitkeep

# Built release packages (attached to GitHub releases, not committed)
release/
